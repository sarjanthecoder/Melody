# EAS Ignore - Controls what files are uploaded to Expo EAS Cloud Build

# Root ignored folders
MelodyRN/
preview/
scripts/
test-archive/

# Dependencies
node_modules/
**/node_modules/

# Native builds
android/
**/build/
android/app/build/
android/.gradle/
**/.gradle/
*.iml
.gradle

# Expo
.expo/
**/.expo/
.bundle/
**/.bundle/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System
.DS_Store
Thumbs.db
.idea/
.vscode/

# Ensure MelodyApp assets and songs are INCLUDED!
!MelodyApp/assets/
!MelodyApp/assets/songs/
!MelodyApp/assets/songs/*.mp3
